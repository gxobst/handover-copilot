# ==========================================
# Shift Handover Copilot - Environment Config
# ==========================================

# --- General Application Config ---
APP_ENV=local                       # local | dev | prod
APP_VERSION=0.1.0                   # image tag / version
PORT=8000                           # Backend port

# --- Persistence / Database ---
# Local SQLite for immediate local dev:
DATABASE_URL=sqlite:///./handover.db
# PostgreSQL / Docker Compose:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/handover

# --- Google Cloud Platform (GCP) & Vertex AI ---
# Fill these in for Vertex AI development
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=europe-west2            # Primary region (fallback: us-west1)
# Path to service account JSON key file (if running locally without gcloud auth ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# --- LLM Service Configuration ---
LLM_BACKEND=vertex                  # vertex | fake (use fake for cost-free tests/CI)
LLM_TIMEOUT_S=20                    # Generation budget timeout in seconds
ACTIVE_MODEL=gemini-3.5-flash-lite  # Primary model
FALLBACK_MODEL=gemini-3.1-flash-lite # Fallback model if primary fails/is retired

# --- Security & Admin API ---
# Secret bearer token for PUT /api/admin/settings
ADMIN_TOKEN=change-this-to-a-secure-random-token

# --- Observability (Grafana Cloud / OpenTelemetry) ---
# Direct OTLP/HTTPS exporter settings
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-encoded-instance-id-and-token>

# --- Webhook Relay & Incident Responder ---
RELAY_WEBHOOK_TOKEN=shared-secret-between-grafana-and-relay
GITHUB_DISPATCH_PAT=ghp_yourPersonalAccessTokenWithRepoScope
GITHUB_REPOSITORY=gxobst/handover-copilot
RELAY_DEDUPE_COOLDOWN_SECONDS=1800

# --- Frontend Configuration ---
VITE_API_MODE=real                  # real | mock (mock runs frontend standalone)
VITE_API_URL=http://localhost:8000  # API endpoint for dev server proxy
