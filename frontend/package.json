{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run codegen:check && vitest run",
    "lint": "eslint .",
    "codegen": "openapi-typescript ../openapi.yaml --root-types --root-types-no-schema-prefix --root-types-keep-casing -o src/types/api.ts",
    "codegen:check": "openapi-typescript ../openapi.yaml --root-types --root-types-no-schema-prefix --root-types-keep-casing --check -o src/types/api.ts"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.4.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
